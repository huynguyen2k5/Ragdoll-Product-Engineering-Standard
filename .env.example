# Ragdoll local backend configuration.
# The installer creates ~/.ragdoll/.env from this template.
# Ragdoll does not auto-read a project workspace's generic .env.
# Use --env-file or RAGDOLL_ENV_FILE only when you explicitly choose another file.
# Process environment variables override values loaded from the selected file.

# Provider selection: auto | openai | anthropic | gemini
RAGDOLL_PROVIDER=auto

# Only the key for the provider you use is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Defaults are current stable models as of v1.0.0.
# Override to use a different model available in your account.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash

# Local API. Core is loopback-only; remote HTTP bind is intentionally unsupported.
RAGDOLL_HOST=127.0.0.1
RAGDOLL_PORT=8765
RAGDOLL_ALLOW_REMOTE_BIND=false

# Local data. If blank, defaults to ~/.ragdoll.
RAGDOLL_HOME=

# Runtime context budgets. These are approximate token budgets.
RAGDOLL_HISTORY_TOKEN_BUDGET=1500
RAGDOLL_PROJECT_CONTEXT_TOKEN_BUDGET=2200
RAGDOLL_MAX_OUTPUT_TOKENS=4096

# Security and local resource limits.
RAGDOLL_OUTBOUND_SECRET_POLICY=redact
RAGDOLL_TELEMETRY=false
RAGDOLL_CLOUD_SYNC=false
RAGDOLL_MAX_REQUEST_BYTES=2097152
RAGDOLL_MAX_PROVIDER_RESPONSE_BYTES=8388608
RAGDOLL_PROVIDER_TIMEOUT_SECONDS=90
RAGDOLL_LOG_LEVEL=INFO
